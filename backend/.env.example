# ─── Qdrant Cloud (vector index, runtime; free-tier may purge!) ─────
QDRANT_URL=https://6901f6ad-9531-4a8d-8386-23f3bee85e2b.eu-central-1-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhY2Nlc3MiOiJtIiwic3ViamVjdCI6ImFwaS1rZXk6YzEwOTE4YTEtOTFlZi00OWE2LWI4MTctMzM1OTkzMzg1MGJkIn0.17QwMlKd1WMSiX6r8G5hgEAic5TRXAUEUUp8-giDTuQ

# Collections inside the shared (Synapse) cluster are prefixed so they
# don't collide with other projects' collections. Default: torch_
TORCH_COLLECTION_PREFIX=torch_

# ─── Backblaze B2 (durable source of truth, S3-compatible API) ──────
# Endpoint comes from B2 web console: Buckets → bucket → "Endpoint"
B2_S3_ENDPOINT_URL=https://s3.eu-central-003.backblazeb2.com
B2_BUCKET=torch

# B2 application-key keyID + applicationKey, used as standard AWS creds
AWS_ACCESS_KEY_ID=K0032BDuUZ2bxJpQoueV6KMclVGtZ3A
AWS_SECRET_ACCESS_KEY=003e8a8c75374e50000000003

# ─── LLM ────────────────────────────────────────────────────────────
# Default provider — `gemini` until anthropic key is set
LLM_PROVIDER=gemini
GEMINI_API_KEY=AIzaSyCF86xb-3rsSUAJrnW3KB57PuoJjx4tNLc
GEMINI_MODEL=gemini-3-flash-preview
USE_GEMINI=true
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── Ingestion ──────────────────────────────────────────────────────
GITHUB_TOKEN=
STACKEXCHANGE_KEY=  # optional, raises SO API quota

# ─── HTTP server ────────────────────────────────────────────────────
TORCH_HOST=0.0.0.0
TORCH_PORT=8000
# Comma-separated. Add your Vercel deploy URL here once it's live.
TORCH_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
